# attestra-mcp. Read tools need nothing.
NEAR_NETWORK=testnet
ATTESTRA_ROOT=
ATTESTRA_RPC_URL=
ATTESTRA_INDEXER_URL=http://localhost:5100
ATTESTRA_AGENT_URL=http://localhost:5300
ATTESTRA_RELAYER_URL=http://localhost:5200
# Testnet signer for write tools (register_schema, create_attestation, revoke_attestation, rate_agent, request_private_check)
ATTESTRA_ACCOUNT_ID=
ATTESTRA_PRIVATE_KEY=
# Daily caps for write tools
MCP_DAILY_CAP_PER_TOOL=20
MCP_DAILY_CAP_TOTAL=50
# 1 turns write tools off even with a signer
MCP_READ_ONLY=0
# Write tools stay off on mainnet unless this is 1
MCP_ALLOW_MAINNET_WRITES=0
