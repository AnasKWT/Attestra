{
  "name": "attestra",
  "version": "1.0.0",
  "description": "Attestra SDK for NEAR: schemas, attestations, authorities, resolvers, delegation, credentials, private AI checks, cross-chain facts and agent reputation.",
  "author": "Anas (https://github.com/AnasKWT)",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/AnasKWT/Attestra.git", "directory": "packages/sdk"},
  "homepage": "https://attestra.site",
  "bugs": "https://github.com/AnasKWT/Attestra/issues",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@noble/ciphers": "2.0.1",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.0.1",
    "near-kit": "0.20.2"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "1.3.6",
    "@types/node": "22.19.1",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "keywords": [
    "near",
    "attestation",
    "attestra",
    "verifiable-credentials",
    "nep-413",
    "chain-signatures",
    "near-ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js"
}
