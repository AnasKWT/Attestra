# Attestra site. Every value has a working public testnet default.
# testnet or mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Deployment root; contracts are <name>.<root> (default attestra.testnet)
NEXT_PUBLIC_ATTESTRA_ROOT=
# RPC tried first (public FastNEAR endpoints follow)
NEXT_PUBLIC_RPC_URL=
# Services (the API host on the VM serves them under /indexer, /relayer, /agent, /keeper, /topup)
NEXT_PUBLIC_INDEXER_URL=http://localhost:5100
NEXT_PUBLIC_RELAYER_URL=http://localhost:5200
NEXT_PUBLIC_AGENT_URL=http://localhost:5300
NEXT_PUBLIC_KEEPER_URL=http://localhost:5400
NEXT_PUBLIC_TOPUP_URL=http://localhost:5500
# Public site URL for absolute links in llms.txt and share cards (empty: relative links)
NEXT_PUBLIC_SITE_URL=
# Shown in the footer and about page (defaults: Anas, https://github.com/AnasKWT, https://github.com/AnasKWT/Attestra)
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_REPO_URL=
# Server side: indexer URL the hosted /mcp route uses (defaults to NEXT_PUBLIC_INDEXER_URL)
INDEXER_URL=
