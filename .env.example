# Attestra stack (compose.yaml). Copy to .env; every value has a working public testnet default.
# Without keys every service runs read-only. Secrets stay in this gitignored file.

NEAR_NETWORK=testnet
ATTESTRA_ROOT=attestra.testnet
POSTGRES_PASSWORD=attestra
# Hostname Caddy serves the API on (VM only)
API_HOST=
# Rate limits read the client address from X-Forwarded-For (Caddy in front); compose defaults it to true
TRUST_PROXY=

# ---- agent
AGENT_PORT=5300
AGENT_PUBLIC_URL=http://localhost:5300
NEARAI_API_KEY=
NEARAI_MODEL=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
CHECKER_PRIVATE_KEY=
CHECKER_MODE=local
OUTLAYER_WASM_URL=
OUTLAYER_WASM_HASH=
OUTLAYER_SECRETS_PROFILE=default
X402_PRICE_CLAIM=
X402_PRICE_AGENT=
GITHUB_TOKEN=
# Rate limits as count/window (s, m, h, d), 0 turns one off; see apps/agent/.env.example
AGENT_RATE_CHECK_IP=5/10m
AGENT_RATE_CHECK_SUBJECT=3/1h
AGENT_CHECK_DAILY=200
AGENT_RATE_JOBS_IP=600/10m
AGENT_RATE_MODEL_IP=30/10m
AGENT_RATE_CHAT_IP=20/10m
AGENT_CHAT_DAILY=500
AGENT_RATE_MCP_IP=300/10m
AGENT_RATE_PAID_IP=60/10m
AGENT_RATE_SETTLE_IP=20/10m

# ---- relayer, keeper, top-up
RELAYER_PORT=5200
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
RELAYER_ALLOWLIST=
RELAYER_DAILY_PER_ATTESTER=50
RELAYER_DAILY_TOTAL=500
RELAYER_STORAGE_BUDGET_NEAR=2
RELAYER_META_DAILY_PER_SENDER=50
RELAYER_META_DAILY_TOTAL=500
RELAYER_GAS_KEY_LANES=0
RELAYER_GAS_KEY=
RELAYER_LOW_BALANCE_NEAR=1
RELAYER_RATE_IP=60/10m
RELAYER_RATE_SPONSOR_IP=20/1d
KEEPER_PORT=5400
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=30000
KEEPER_MAX_LAG_BLOCKS=300
KEEPER_MAX_PER_TICK=20
KEEPER_DRIFT_SAMPLE=20
KEEPER_LOW_BALANCE_NEAR=0.5
KEEPER_DAOS=
KEEPER_DAO_ROLES=member,contributor
KEEPER_RATE_RUN_IP=5/1h
KEEPER_RATE_DAO_IP=5/1h
KEEPER_RATE_MEMBERSHIP_ACCOUNT=1/1d
TOPUP_PORT=5500
TOPUP_INTERVAL_MS=600000
TOPUP_ACCOUNTS=
TOPUP_DAILY_CAP_NEAR=10
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
TREASURY_WARN_NEAR=15
TOPUP_RATE_RUN_IP=5/1h
TOPUP_RATE_BALANCES_IP=60/1m

# ---- indexer
FASTNEAR_API_KEY=
START_HEIGHT=
INDEXER_RATE_IP=1200/1m
INDEXER_RATE_SEARCH_IP=120/1m
