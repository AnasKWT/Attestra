# Attestra indexer. Every value has a working public testnet default.
NEAR_NETWORK=testnet
ATTESTRA_ROOT=attestra.testnet
DATABASE_URL=postgres://localhost:5432/attestra
# FastNEAR transactions API (default by network) and RPC
TX_API_URL=
RPC_URL=
# Optional FastNEAR key: lifts the free limit of about 60 requests a minute
FASTNEAR_API_KEY=
PORT=5100
# First block to read on an empty database (the deployment height in deployments/<network>.json)
START_HEIGHT=0
POLL_MS=4000
LAG_BLOCKS=3
