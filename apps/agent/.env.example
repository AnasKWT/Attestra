# Attestra agent. Without keys it serves its card, MCP and /health, and says what is off.
NEAR_NETWORK=testnet
ATTESTRA_ROOT=attestra.testnet
RPC_URL=
INDEXER_URL=http://localhost:5100
AGENT_PORT=5300
# Public URL in the A2A card (the API host on the VM, for example https://api.example.com/agent)
AGENT_PUBLIC_URL=http://localhost:5300
# NEAR AI Cloud API key (secret): chat and private checks
NEARAI_API_KEY=
# A verifiable model id; empty picks the cheapest capable verifiable model from the live list
NEARAI_MODEL=
# The agent account settles x402 payments and submits private-check verdicts (default agent.<root>)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# local: this process checks and signs with CHECKER_PRIVATE_KEY
# outlayer: the checker/ build checks inside an OutLayer TEE and signs with a key bound to that build;
# the agent account starts each run on chain (request_execution on outlayer.<network>) and pays its cost
CHECKER_MODE=local
# local mode: the ed25519 secret verdicts are signed with; the verdicts contract must list its public key
CHECKER_PRIVATE_KEY=
# outlayer mode: the published checker wasm (from checker/build.sh --reproducible) and its sha256
OUTLAYER_WASM_URL=
OUTLAYER_WASM_HASH=
# outlayer mode: the profile of the agent account's OutLayer secrets row for that hash (NEARAI_API_KEY, optional GITHUB_TOKEN)
OUTLAYER_SECRETS_PROFILE=default
# Prices in the payment token's smallest unit (test token on testnet: 18 decimals; USDC on mainnet: 6)
X402_PRICE_CLAIM=
X402_PRICE_AGENT=
# Optional GitHub token for higher rate limits on GitHub rules
GITHUB_TOKEN=
# NEAR Agent Market: the listing's token (scripts/market-listing.ts --register, with the owner's go-ahead); empty keeps the market worker off
MARKET_AGENT_TOKEN=
MARKET_URL=https://market.near.ai
