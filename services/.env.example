# Attestra services (relayer, keeper, top-up). Every value has a working public testnet default;
# leave a line empty to use it. Without its private key a service runs idle (read-only) and
# /health answers ok: false with the reason.

# ---------------------------------------------------------------- shared
# testnet or mainnet
NEAR_NETWORK=testnet
# Deployment root; contracts are <name>.<root> (default attestra.testnet)
ATTESTRA_ROOT=attestra.testnet
# RPC endpoint tried first (the SDK's public endpoints follow as fallbacks)
RPC_URL=
# Attestra indexer REST API
INDEXER_URL=http://localhost:5100
# Where the daily budgets and the sponsored accounts are kept across restarts
DATA_DIR=.data
# Rate limits count the client from the first X-Forwarded-For hop: true only behind a proxy that
# replaces it (Caddy in compose.yaml, where it defaults to true); false uses the connection address.
TRUST_PROXY=false
# Every rate limit below is count/window (units s, m, h, d), per client address unless named
# otherwise; 0 turns it off. A refusal is a 429 with Retry-After. /live and /health are never limited.

# ---------------------------------------------------------------- relayer (port 5200)
RELAYER_PORT=5200
# Default relayer.<root>
RELAYER_ACCOUNT_ID=
# Full-access key of the relayer account (secret)
RELAYER_PRIVATE_KEY=
# Attesters the relayer submits for, comma-separated; empty means anyone
RELAYER_ALLOWLIST=
# Signed submissions per attester per day
RELAYER_DAILY_PER_ATTESTER=50
# Signed submissions per day in total
RELAYER_DAILY_TOTAL=500
# NEAR per day for attesters' storage (0.02 per low attester, 0.05 per sponsored deposit)
RELAYER_STORAGE_BUDGET_NEAR=2
# NEP-366 meta transactions per sender per day, and in total
RELAYER_META_DAILY_PER_SENDER=50
RELAYER_META_DAILY_TOTAL=500
# Parallel nonce lanes on a gas key; 0 sends one transaction at a time (see scripts/setup-gas-key.ts)
RELAYER_GAS_KEY_LANES=0
# Gas key private key (secret), added with scripts/setup-gas-key.ts
RELAYER_GAS_KEY=
# /health reports ok: false below this balance (NEAR)
RELAYER_LOW_BALANCE_NEAR=1
# Every POST /v1/* request
RELAYER_RATE_IP=60/10m
# Sponsorships that send NEAR (storage deposits and passkey funding; each account is sponsored once, ever)
RELAYER_RATE_SPONSOR_IP=20/1d

# ---------------------------------------------------------------- keeper (port 5400)
KEEPER_PORT=5400
# Default keeper.<root>
KEEPER_ACCOUNT_ID=
# Key of the keeper account (secret); without it only the drift check runs
KEEPER_PRIVATE_KEY=
# Time between passes
KEEPER_INTERVAL_MS=30000
# Indexer lag (blocks) above which /health reports ok: false
KEEPER_MAX_LAG_BLOCKS=300
# Most finalize_revocation / record_expiry transactions per pass
KEEPER_MAX_PER_TICK=20
# Newest attestations compared with the chain per pass
KEEPER_DRIFT_SAMPLE=20
# /health reports ok: false below this balance (NEAR)
KEEPER_LOW_BALANCE_NEAR=0.5
# Sputnik DAOs whose membership proposals the keeper votes on as a council member (comma-separated);
# empty means the deployment DAO (attestra.sputnik-v2.testnet on testnet), none turns it off
KEEPER_DAOS=
# Membership roles the keeper approves without a human vote
KEEPER_DAO_ROLES=member,contributor
# POST /v1/run and POST /v1/dao/*
KEEPER_RATE_RUN_IP=5/1h
KEEPER_RATE_DAO_IP=10/1h
# Memberships issued per account (counted only when one is issued)
KEEPER_RATE_MEMBERSHIP_ACCOUNT=1/1d

# ---------------------------------------------------------------- top-up (port 5500)
TOPUP_PORT=5500
# Time between runs (POST /v1/run also runs one)
TOPUP_INTERVAL_MS=600000
# Watched wallets as account:min:target (NEAR), comma-separated.
# Default relayer.<root>:3:6,keeper.<root>:1:2,agent.<root>:2:4
TOPUP_ACCOUNTS=
# Most NEAR sent per day
TOPUP_DAILY_CAP_NEAR=10
# Account the refills come from (default attestra-treasury.testnet)
TREASURY_ACCOUNT_ID=
# Treasury key (secret); without it refills are only planned
TREASURY_PRIVATE_KEY=
# /api/balances says treasury_low below this (NEAR)
TREASURY_WARN_NEAR=15
# POST /v1/run and GET /api/balances
TOPUP_RATE_RUN_IP=5/1h
TOPUP_RATE_BALANCES_IP=60/1m
