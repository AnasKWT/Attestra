# attestra CLI. Every value has a working public testnet default.
ATTESTRA_NETWORK=testnet
# Signer account; its key is read from ~/.near-credentials/<network>/<account>.json unless set below
ATTESTRA_ACCOUNT_ID=
ATTESTRA_PRIVATE_KEY=
ATTESTRA_ROOT=
ATTESTRA_RPC_URL=
ATTESTRA_INDEXER_URL=http://localhost:5100
ATTESTRA_RELAYER_URL=http://localhost:5200
ATTESTRA_AGENT_URL=http://localhost:5300
# For `attestra delegate sign`: the ed25519 key that signs delegated requests
ATTESTRA_SIGNER_KEY=
# For `attestra ai`: NEAR AI Cloud key and a verifiable model id
NEARAI_API_KEY=
NEARAI_MODEL=
