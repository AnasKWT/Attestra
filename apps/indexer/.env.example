# Attestra indexer. Every value has a working public testnet default.
NEAR_NETWORK=testnet
ATTESTRA_ROOT=attestra.testnet
DATABASE_URL=postgres://localhost:5432/attestra
# FastNEAR transactions API (default by network) and RPC
TX_API_URL=
RPC_URL=
# Optional FastNEAR key: lifts the free limit of about 60 requests a minute
FASTNEAR_API_KEY=
PORT=5100
# First block to read on an empty database (the deployment height in deployments/<network>.json)
START_HEIGHT=
POLL_MS=4000
LAG_BLOCKS=3
# Rate limits read the client address from the first X-Forwarded-For hop: true only behind a proxy
# that replaces it (Caddy in compose.yaml, where it defaults to true); false uses the connection address
TRUST_PROXY=false
# Per client address, count/window (units s, m, h, d), 0 turns one off: every /api/* request, and
# /api/search on top (a refusal is a 429 with Retry-After; /live and /health are never limited)
INDEXER_RATE_IP=1200/1m
INDEXER_RATE_SEARCH_IP=120/1m
