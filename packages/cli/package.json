{
  "name": "attestra-cli",
  "version": "1.0.0",
  "description": "Attestra command line: schemas, attestations, authorities, resolvers, delegation, credentials, light client proofs, private AI checks, cross-chain facts and agent reputation on NEAR.",
  "author": "Anas (https://github.com/AnasKWT)",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/AnasKWT/Attestra.git", "directory": "packages/cli"},
  "homepage": "https://attestra.site",
  "bugs": "https://github.com/AnasKWT/Attestra/issues",
  "type": "module",
  "bin": {
    "attestra": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "attestra": "workspace:*",
    "commander": "14.0.2",
    "near-kit": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "fast-check": "4.10.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "near",
    "attestation",
    "attestra",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
