{
  "name": "attestra",
  "version": "1.0.0",
  "private": true,
  "description": "Attestra: the trust layer for NEAR. Schema-based attestations about people, wallets on any chain, and AI agents.",
  "author": "Attestra contributors",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @attestra/sdk build && pnpm --filter @attestra/mcp build && pnpm --filter @attestra/cli build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test:contracts": "cd contracts && cargo test --workspace --exclude attestra-sandbox-tests",
    "test:sandbox": "cd contracts && cargo test -p attestra-sandbox-tests -- --test-threads=1",
    "build:contracts": "contracts/scripts/build.sh",
    "security": "tsx scripts/security.ts",
    "verify": "tsx scripts/verify.ts",
    "dev": "tsx scripts/dev.ts",
    "build:web": "pnpm --filter @attestra/web build",
    "deploy:testnet": "tsx scripts/deploy.ts testnet",
    "deploy:sandbox": "tsx scripts/deploy.ts sandbox"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@attestra/sdk": "workspace:*",
    "near-kit": "0.20.2",
    "@types/node": "22.19.1"
  }
}
