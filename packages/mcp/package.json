{
  "name": "@attestra/mcp",
  "version": "1.0.0",
  "description": "Attestra MCP server: read schemas, attestations, authorities and agent reputation on NEAR, check light client proofs, and (on testnet, capped) register schemas, attest, revoke and request private AI checks.",
  "author": "Attestra contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "attestra-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@attestra/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "mcp",
    "near",
    "attestation",
    "attestra",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
