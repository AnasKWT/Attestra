{
  "name": "@attestra/web",
  "version": "1.0.0",
  "private": true,
  "description": "Attestra site: landing, explorer, sandbox, docs, agent chat, hosted MCP and llms.txt.",
  "author": "Attestra contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:shots": "E2E_SHOTS=1 playwright test",
    "e2e:live": "E2E_LIVE=${E2E_LIVE:-http://localhost:3100} playwright test"
  },
  "dependencies": {
    "@attestra/mcp": "workspace:*",
    "@attestra/sdk": "workspace:*",
    "@hot-labs/near-connect": "0.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.0.1",
    "lucide-react": "1.14.0",
    "near-kit": "0.20.2",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
