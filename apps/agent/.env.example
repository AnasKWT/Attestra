# Attestra agent. Without keys it serves its card, MCP and /health, and says what is off.
NEAR_NETWORK=testnet
ATTESTRA_ROOT=attestra.testnet
RPC_URL=
INDEXER_URL=http://localhost:5100
AGENT_PORT=5300
# Public URL in the A2A card (the API host on the VM, for example https://api.example.com/agent)
AGENT_PUBLIC_URL=http://localhost:5300
# NEAR AI Cloud API key (secret): chat and private checks
NEARAI_API_KEY=
# A verifiable model id; empty picks the cheapest capable verifiable model from the live list
NEARAI_MODEL=
# The agent account settles x402 payments and submits private-check verdicts (default agent.<root>)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# local: this process checks and signs with CHECKER_PRIVATE_KEY
# outlayer: the checker/ build checks inside an OutLayer TEE and signs with a key bound to that build;
# the agent account starts each run on chain (request_execution on outlayer.<network>) and pays its cost
CHECKER_MODE=local
# local mode: the ed25519 secret verdicts are signed with; the verdicts contract must list its public key
CHECKER_PRIVATE_KEY=
# outlayer mode: the published checker wasm (from checker/build.sh --reproducible) and its sha256
# (testnet's: https://test.fastfs.io/agent.attestra.testnet/outlayer.testnet/4a878586fb91e6debc543e51481b9b23274f034fb8945be547aea4fb8a4b3410.wasm
#  and 4a878586fb91e6debc543e51481b9b23274f034fb8945be547aea4fb8a4b3410; pnpm outlayer:publish prints both for your own agent account)
OUTLAYER_WASM_URL=
OUTLAYER_WASM_HASH=
# outlayer mode: the profile of the agent account's OutLayer secrets row for that hash (NEARAI_API_KEY, optional GITHUB_TOKEN)
OUTLAYER_SECRETS_PROFILE=default
# Prices in the payment token's smallest unit (test token on testnet: 18 decimals; USDC on mainnet: 6)
X402_PRICE_CLAIM=
X402_PRICE_AGENT=
# Optional GitHub token for higher rate limits on GitHub rules
GITHUB_TOKEN=
# NEAR Agent Market: the listing's token from registering the agent on market.near.ai; empty keeps the market worker off
MARKET_AGENT_TOKEN=
MARKET_URL=https://market.near.ai
# Rate limits read the client address from the first X-Forwarded-For hop: true only behind a proxy
# that replaces it (Caddy in compose.yaml, where it defaults to true); false uses the connection address
TRUST_PROXY=false
# Rate limits as count/window (units s, m, h, d), per client address unless named otherwise; 0 turns
# one off. A refusal is a 429 with Retry-After; /live and /health are never limited.
# POST /v1/check (in front of the subject's signature check)
AGENT_RATE_CHECK_IP=5/10m
# Private checks per subject account, counted once the subject's signature verified
AGENT_RATE_CHECK_SUBJECT=3/1h
# Private checks per UTC day from every client together
AGENT_CHECK_DAILY=200
# GET /v1/check/jobs/:id (a client polls every 3 seconds) and GET /v1/check/model
AGENT_RATE_JOBS_IP=600/10m
AGENT_RATE_MODEL_IP=30/10m
# POST /v1/chat and POST /a2a together, and chats per UTC day from every client together
AGENT_RATE_CHAT_IP=20/10m
AGENT_CHAT_DAILY=500
# /mcp
AGENT_RATE_MCP_IP=300/10m
# Paid endpoints without a payment (the 402 challenge), and with one (the agent pays the gas to settle it)
AGENT_RATE_PAID_IP=60/10m
AGENT_RATE_SETTLE_IP=20/10m
